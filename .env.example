# ============================================================================
#  Telegram Giveaway Bot — single source of configuration.
#  Copy this file to ".env" and fill in the values. Everything the bot needs
#  to run lives here.
# ============================================================================

# --- Docker isolation -------------------------------------------------------
# Unique name so this stack's containers/volumes/network never clash with other
# bots on the same server. Change it per bot (e.g. giveaway_bot, lottery_bot).
COMPOSE_PROJECT_NAME=giveaway_bot

# --- Telegram ---------------------------------------------------------------
BOT_TOKEN=123456:your_bot_token_here
# Comma-separated Telegram user IDs that may use the admin panel.
ADMIN_IDS=123456789,987654321
# Channel users must be subscribed to (numeric -100... id).
CHANNEL_ID=-1001234567890
# Link the "Участвовать" button points to (your bot's start link).
JOIN_URL=https://t.me/your_bot?start=join

# --- PostgreSQL -------------------------------------------------------------
# Credentials for the bundled postgres container.
POSTGRES_USER=giveaway_user
POSTGRES_PASSWORD=change_me_strong_password
POSTGRES_DB=giveaway_bot
# Connection string used by the bot. Host "postgres" is the compose service name.
DATABASE_URL=postgresql+asyncpg://giveaway_user:change_me_strong_password@postgres:5432/giveaway_bot
# Optional: expose Postgres on the host (only if you uncomment ports in compose).
# POSTGRES_HOST_PORT=5433

# --- Redis ------------------------------------------------------------------
# Host "redis" is the compose service name. Use a distinct DB number per bot
# if you ever point several bots at one shared Redis.
REDIS_URL=redis://redis:6379/0
# Namespace for FSM keys so multiple bots can safely share one Redis.
REDIS_FSM_PREFIX=giveaway_fsm
# Optional: expose Redis on the host (only if you uncomment ports in compose).
# REDIS_HOST_PORT=6380

# --- Behaviour --------------------------------------------------------------
# All displayed times are fixed to Moscow time (МСК, GMT+3) regardless of the
# server's timezone — this is intentional and not configurable.
# Mass-mailing rate limits (messages per second).
BROADCAST_RPS=20
ANNOUNCE_RPS=20
MAX_RETRIES=5
# Database connection pool sizing (keep modest when sharing a server).
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10

# --- Google Sheets (optional) ----------------------------------------------
SHEETS_SYNC_ENABLED=false
# GOOGLE_CREDENTIALS_PATH=/app/service_account.json
# SPREADSHEET_ID=your_spreadsheet_id

# --- Logging / observability ------------------------------------------------
LOG_LEVEL=INFO
# SENTRY_DSN=https://...@sentry.io/...
